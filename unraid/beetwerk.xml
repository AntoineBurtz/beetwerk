<?xml version="1.0"?>
<Container version="2">
  <Name>beetwerk</Name>
  <Repository>ghcr.io/antoineburtz/beetwerk:latest</Repository>
  <Registry>https://github.com/AntoineBurtz/beetwerk/pkgs/container/beetwerk</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/AntoineBurtz/beetwerk</Support>
  <Project>https://github.com/AntoineBurtz/beetwerk</Project>
  <Overview>Anbauplanung für den Gemüsegarten: Beetkarte und Zeitleiste nach Beeten, gekoppelt über einen Stichtag. Fruchtfolge- und Konfliktprüfung, Aufgaben, Bedarfsliste.</Overview>
  <Category>Productivity: Tools:</Category>
  <WebUI>http://[IP]:[PORT:8000]/</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/AntoineBurtz/beetwerk/main/unraid/icon.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Weboberfläche" Target="8000" Default="8000" Mode="tcp" Description="Port der Weboberfläche" Type="Port" Display="always" Required="true" Mask="false">8000</Config>
  <Config Name="Daten" Target="/data" Default="/mnt/user/appdata/beetwerk" Mode="rw" Description="SQLite-Datenbank mit Beeten, Kulturen und Sätzen" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/beetwerk</Config>
  <Config Name="Passwort" Target="BEETWERK_PASSWORD" Default="" Mode="" Description="Leer lassen für keinen Passwortschutz" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Benutzername" Target="BEETWERK_USER" Default="garten" Mode="" Description="Benutzername für den Passwortschutz" Type="Variable" Display="advanced" Required="false" Mask="false">garten</Config>
  <Config Name="Zeitzone" Target="TZ" Default="Europe/Berlin" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">Europe/Berlin</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="Benutzer-ID für die Dateien (Unraid: 99 = nobody)" Type="Variable" Display="advanced" Required="true" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Gruppen-ID für die Dateien (Unraid: 100 = users)" Type="Variable" Display="advanced" Required="true" Mask="false">100</Config>
</Container>
